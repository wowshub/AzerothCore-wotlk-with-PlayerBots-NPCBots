#
# Reborn LootLab Module Configuration
# 掉落工坊配置文件 (阶段 LAB1, 只读)
#

[worldserver]

###################################################################################################
#    RebornLootLab.Enable
#        Description: 是否启用掉落工坊 (.lootlab 命令)。
#        Default:     1 (启用)
#                     0 (禁用)
#

RebornLootLab.Enable = 1

#
#    RebornLootLab.SimMaxRuns
#        Description: “模拟掉落”一次最多模拟的次数。
#        Default:     20000
#

RebornLootLab.SimMaxRuns = 20000


#
#    RebornLootLab.Edit.Enable
#        Description: 是否允许在掉落工坊里编辑掉落表（改概率/数量/分组、添加/删除物品、撤销、还原官方）。
#                     改动直接写 world 库，并在首次改动前自动保存一份官方原样（reborn_lootlab_baseline，只存一次）。
#        Default:     0 (关闭，只读)
#                     1 (开启)
#

RebornLootLab.Edit.Enable = 0

#
#    RebornLootLab.Edit.Lock
#        Description: 正式服锁定：置 1 后无论什么账号等级，都不能编辑（只读）。
#        Default:     0
#

RebornLootLab.Edit.Lock = 0

#
#    RebornLootLab.Edit.MinSecurity
#        Description: 允许编辑的最低账号等级（0 玩家 1 版主 2 游戏管理员 3 管理员）。
#        Default:     3
#

RebornLootLab.Edit.MinSecurity = 3

#
#    RebornLootLab.Log.WarnMB
#        Description: 改动日志达到这个大小（MB）时，掉落工坊顶部的日志大小变橙色并提示归档。
#        Default:     20
#

RebornLootLab.Log.WarnMB = 20

#
#    RebornLootLab.Log.CriticalMB
#        Description: 达到这个大小（MB）时变红色，强烈建议归档。
#        Default:     100
#

RebornLootLab.Log.CriticalMB = 100

#
#    RebornLootLab.Log.KeepDays
#        Description: “归档并清理”对话框里默认保留的天数：更早的日志写入文件，再从数据库删除。
#                     每张表最新的一条日志总会保留，所以"撤销"和"还原官方"不受影响。
#        Default:     30
#

RebornLootLab.Log.KeepDays = 30

#
#    RebornLootLab.Log.ArchiveDir
#        Description: 归档文件（每行一个 JSON）写到哪个目录；相对路径是相对 worldserver 的运行目录。
#        Default:     lootlab_archive
#

RebornLootLab.Log.ArchiveDir = lootlab_archive

###################################################################################################
# LAB3C 时间点
###################################################################################################

#
#    RebornLootLab.Snapshot.AutoMinutes
#        Description: 每隔多少分钟自动保存一个时间点（只有改动日志有新内容、且内容真的变了才会存）。0 = 关闭自动时间点。
#        Default:     60
#

RebornLootLab.Snapshot.AutoMinutes = 60

#
#    RebornLootLab.Snapshot.AutoKeep
#        Description: 自动时间点（含"回到某时间点之前自动保存"的那种）最多保留多少个，更早的删除。0 = 不限个数。手动保存的永不自动删除。
#        Default:     48
#

RebornLootLab.Snapshot.AutoKeep = 48

#
#    RebornLootLab.Snapshot.AutoKeepDays
#        Description: 自动时间点最多保留多少天。0 = 不限天数。
#        Default:     14
#

RebornLootLab.Snapshot.AutoKeepDays = 14
