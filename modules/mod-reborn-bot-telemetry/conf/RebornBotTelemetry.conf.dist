[worldserver]

########################################
# mod-reborn-bot-telemetry (RebornWOW, DC line P1)
########################################
#
# Writes one JSON line per group fight to BotTelemetry.File: party members
# (class, spec tab, role, bot/human, item level), damage done, effective
# healing done, damage taken, deaths, time under 50% / 25% health, boss, wipe.
# Pairs with mod-dungeon-clear's dc_testruns.jsonl for the bot statistics site.
# All values are re-read on `.reload config`.
#
#    BotTelemetry.Enable
#        1 = record fights, 0 = off (the hooks return immediately).
#        Default: 1
BotTelemetry.Enable = 1

#    BotTelemetry.DungeonsOnly
#        1 = only fights inside dungeon / raid instances.
#        Default: 1
BotTelemetry.DungeonsOnly = 1

#    BotTelemetry.BotGroupsOnly
#        1 = only groups that contain at least one playerbot (bot test parties
#        and players running with bots); groups of real players only are skipped.
#        Default: 1
BotTelemetry.BotGroupsOnly = 1

#    BotTelemetry.SampleMs
#        How often fight state and health are sampled (ms, min 100).
#        Default: 500
BotTelemetry.SampleMs = 500

#    BotTelemetry.EndAfterMs
#        A fight ends after nobody in the group has been in combat this long.
#        Default: 4000
BotTelemetry.EndAfterMs = 4000

#    BotTelemetry.MinFightMs
#        Shorter fights (a stray critter) are not written.
#        Default: 5000
BotTelemetry.MinFightMs = 5000

#    BotTelemetry.File
#        Output file, relative to the worldserver working directory.
#        Default: "dc_fights.jsonl"
BotTelemetry.File = "dc_fights.jsonl"

#    BotTelemetry.FallLog
#        DCDIAG1A fall recorder: write a line whenever a tracked player drops
#        steeply (a ledge, a hole, a knockback) inside a dungeon.
#        Default: 1
BotTelemetry.FallLog = 1

#    BotTelemetry.FallMinDrop
#        Smallest drop in yards that counts as a fall (min 3).
#        Default: 10
BotTelemetry.FallMinDrop = 10

#    BotTelemetry.FallFile
#        Fall output file, relative to the worldserver working directory.
#        Default: "dc_falls.jsonl"
BotTelemetry.FallFile = "dc_falls.jsonl"

#    BotTelemetry.IdleEndMs
#        TELE1A: close a fight in which nobody in the party has dealt or taken
#        damage or healing for this long, written with "endedBy":"idle". Without
#        it, a mob that keeps the party combat-flagged out of reach (Gundrak's
#        Drakkari Raider in the water) swallowed every later fight into one
#        record that was never written. 0 = off.
#        Default: 30000
BotTelemetry.IdleEndMs = 30000

#    BotTelemetry.HolderLogAfterMs
#        TELE1A: after this long without damage or healing in a fight, log
#        (Server.log, "TELE1A:") who is still in combat and with which creature
#        (name, entry, distance, health, height, evading), every 30 s. 0 = off.
#        Default: 15000
BotTelemetry.HolderLogAfterMs = 15000

# WDN5B: optional final NPCBot direct-healing diagnostics (independent of BotTelemetry.Enable).
# Written by Unit::HealBySpell to logger "server", INFO, prefix [NPCBOT-HEAL].
# No changes to dc_fights.jsonl. Does not include summon-cast healing or direct DealHeal calls.
# Options are read per heal; after a successful .reload config, subsequent heals use new values.
# Default disabled. MinHeal filters effective + overheal (post-absorb); zero total is omitted.
RebornBotTelemetry.NpcBotHealLog = 0
RebornBotTelemetry.NpcBotHealLog.MinHeal = 1
